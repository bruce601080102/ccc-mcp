# Set in the OS environment; this file is not loaded automatically.
# Register a project, then grant access once in the local terminal:
# ccc-mcp project add "D:/Projects/my-app" --id my-app
# ccc-mcp project authorize my-app
# CCC_MCP_HOME=C:\Users\YOUR_NAME\.ccc-mcp
# Real agents are opt-in; Fake requires no login or model credits.
CCC_MCP_ENABLE_REAL_AGENTS=0
