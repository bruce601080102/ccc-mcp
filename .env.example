# Set in the OS environment; this file is not loaded automatically.
# Project locations and read roots are configured with the CLI, not this file:
# agentbridge project create my-app --path "D:/Projects/my-app"
# agentbridge --project my-app config worktree-dir "D:/AgentWork"
# agentbridge --project my-app config read-root specs "D:/Documents/specs"
# AGENTBRIDGE_HOME=C:\Users\YOUR_NAME\.agentbridge
# Real agents are opt-in; Fake requires no login or model credits.
AGENTBRIDGE_ENABLE_REAL_AGENTS=0
